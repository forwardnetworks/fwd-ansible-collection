## Copy to ./.env (not committed) and fill in values.
##
## Auth (Forward OpenAPI uses HTTP Basic):
## - Either use token-only (username=<token>, password empty) via FORWARD_TOKEN
## - Or use username/password via FWD_USER/FWD_PASS (or FORWARD_USERNAME/FORWARD_PASSWORD)

FWD_HOST=https://fwd.app
FWD_USER=your_user_or_token
FWD_PASS=your_password_or_empty
FWD_NETWORKID=123456

# Collection uses these env vars by default (aliases supported):
# FORWARD_BASE_URL=https://fwd.app
# FORWARD_TOKEN=...
# FORWARD_USERNAME=...
# FORWARD_PASSWORD=...

