## Copy to ./.env (not committed) and fill in values.
##
## Auth is an API token: its access key is the username and its secret is the password.
## These are the variable names forward-sdk reads (the same ones the Forward NetBox and
## Nautobot plugins use).

FORWARD_URL=https://fwd.app
FORWARD_USERNAME=your_api_token_access_key
FORWARD_PASSWORD=your_api_token_secret
FORWARD_NETWORK_ID=123456

## Optional
# FORWARD_SNAPSHOT_ID=
# FORWARD_VERIFY_TLS=false        # or a path to a CA bundle for a private CA
# FORWARD_TIMEOUT=300
# FORWARD_RETRIES=4
# FORWARD_RATE_LIMIT_RPM=1800

## The collection's older names still work and are translated: FORWARD_BASE_URL / FWD_HOST,
## FWD_USER, FWD_PASS, FORWARD_VALIDATE_CERTS, FWD_NETWORKID (inventory plugin only).
## FORWARD_TOKEN is no longer used.
